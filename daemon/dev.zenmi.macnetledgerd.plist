<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.zenmi.macnetledgerd</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>PYTHON=$(command -v python3 || echo /usr/bin/python3); exec "$PYTHON" /usr/local/bin/macnetledgerd --db "/Library/Application Support/MacNetLedger/ledger.db"</string>
    </array>

    <!-- Automatically start on boot and system wake -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Keep running indefinitely; restart if killed or network drops -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>1</integer>

    <!-- Standard system service so launchd does not defer/throttle start -->
    <key>ProcessType</key>
    <string>Standard</string>

    <key>StandardOutPath</key>
    <string>/var/log/macnetledgerd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/macnetledgerd.error.log</string>
</dict>
</plist>
